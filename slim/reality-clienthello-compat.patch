From dfd19d104fd1dbed9428694e166bf79283c73686 Mon Sep 17 00:00:00 2001
From: Timur Iskhakov <me@timur.is>
Date: Tue, 20 Oct 2026 11:34:11 +0100
Subject: [PATCH] Fix reality client stripping X25519MLKEM768 key share

Since Xray-core v26.9.8 (XTLS/REALITY 8cdf7bf9) the server rejects a
ClientHello without an X25519MLKEM768 key share ahead of X25519, so the
chrome fingerprint failed with "reality verification failed".

Keep X25519MLKEM768 when the fingerprint sends both the group and a
share; otherwise strip it as before. randomized picks the two
independently, and a group without a share draws a HelloRetryRequest
from post-quantum-preferring targets that REALITY cannot relay.

Servers without X25519MLKEM768 support (Xray-core before v25.5.16,
sing-box before 1.12) now fail with chrome when the target selects it,
as Xray's own chrome client does.

Based on thatssoheil/sing-box@87f2d718a, which deleted the filter
outright.

Fixes #4520

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 common/tls/reality_client.go | 37 +++++++++++++++++++++++++-----------
 1 file changed, 26 insertions(+), 11 deletions(-)

diff --git a/common/tls/reality_client.go b/common/tls/reality_client.go
index 13f88e385bf..a19012905ba 100644
--- a/common/tls/reality_client.go
+++ b/common/tls/reality_client.go
@@ -145,21 +145,36 @@ func (e *RealityClientConfig) ClientHandshake(ctx context.Context, conn net.Conn
 	if err != nil {
 		return nil, err
 	}
+	var mlkemCurve, mlkemKeyShare bool
 	for _, extension := range uConn.Extensions {
-		if ce, ok := extension.(*utls.SupportedCurvesExtension); ok {
-			ce.Curves = common.Filter(ce.Curves, func(curveID utls.CurveID) bool {
-				return curveID != utls.X25519MLKEM768
-			})
-		}
-		if ks, ok := extension.(*utls.KeyShareExtension); ok {
-			ks.KeyShares = common.Filter(ks.KeyShares, func(share utls.KeyShare) bool {
-				return share.Group != utls.X25519MLKEM768
+		switch ext := extension.(type) {
+		case *utls.SupportedCurvesExtension:
+			mlkemCurve = common.Contains(ext.Curves, utls.X25519MLKEM768)
+		case *utls.KeyShareExtension:
+			mlkemKeyShare = common.Any(ext.KeyShares, func(share utls.KeyShare) bool {
+				return share.Group == utls.X25519MLKEM768
 			})
 		}
 	}
-	err = uConn.BuildHandshakeState()
-	if err != nil {
-		return nil, err
+	// A group without its key share draws a HelloRetryRequest from post-quantum-preferring targets, which uTLS cannot answer.
+	// A key share without its group is forbidden by RFC 8446, Section 4.2.8, and OpenSSL targets abort with illegal_parameter.
+	if mlkemCurve != mlkemKeyShare {
+		for _, extension := range uConn.Extensions {
+			if ce, ok := extension.(*utls.SupportedCurvesExtension); ok {
+				ce.Curves = common.Filter(ce.Curves, func(curveID utls.CurveID) bool {
+					return curveID != utls.X25519MLKEM768
+				})
+			}
+			if ks, ok := extension.(*utls.KeyShareExtension); ok {
+				ks.KeyShares = common.Filter(ks.KeyShares, func(share utls.KeyShare) bool {
+					return share.Group != utls.X25519MLKEM768
+				})
+			}
+		}
+		err = uConn.BuildHandshakeState()
+		if err != nil {
+			return nil, err
+		}
 	}
 
 	if len(uConfig.NextProtos) > 0 {
